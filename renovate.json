{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^(apps|clusters)/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^apps/[^/]+/(base|overlays/[^/]+)/[^/]+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": ["docker.io/envoyproxy/gateway-helm"],
      "groupName": "Envoy Gateway controller and CRDs"
    }
  ]
}
